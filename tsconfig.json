{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // ini penting 👇
    "baseUrl": "./src",
    "paths": {
      "@shared/*": ["shared/*"],
      "@api/*": ["features/api/*"],
      "@ui/*": ["features/ui/*"],
      "@e2e/": ["e2e"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
